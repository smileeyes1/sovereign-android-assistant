<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="com.termux.permission.RUN_COMMAND"
        tools:node="remove" />

    <queries>
        <package android:name="com.termux" tools:node="remove" />
    </queries>

    <application>
        <activity
            android:name=".HakimMobileTaskActivity"
            tools:node="remove" />
        <activity
            android:name=".HakimRouterAuthActivity"
            tools:node="remove" />
        <activity
            android:name=".HakimFamilyDnsVpnActivity"
            tools:node="remove" />

        <receiver
            android:name=".HakimTermuxResultReceiver"
            tools:node="remove" />

        <service
            android:name=".HakimFamilyDnsVpnService"
            tools:node="remove" />
        <service
            android:name=".HakimNetworkGuardianJobService"
            tools:node="remove" />
        <service
            android:name=".UpdateJobService"
            tools:node="remove" />
    </application>
</manifest>
