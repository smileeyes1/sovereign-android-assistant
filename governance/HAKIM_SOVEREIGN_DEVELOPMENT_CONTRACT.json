  "source_of_truth": {
    "repository": "smileeyes1/sovereign-android-assistant",
    "required_reads_before_work": [
      "governance/HAKIM_ACTIVE_STATE.json",
      "governance/HAKIM_SOVEREIGN_DEVELOPMENT_CONTRACT.json",
      "current release branch",
      "open pull requests",
      "latest CI results"
    ],
    "stale_conversation_never_overrides_live_state": true
  },
  "closed_loop": [
    "OBSERVE",
    "MEASURE",
    "DETECT_MATERIAL_GAP",
    "CAPTURE_BOUNDED_EVIDENCE",
    "PRIORITIZE",
    "DESIGN",
    "ISOLATED_BRANCH",
    "IMPLEMENT",
    "TEST_ROOT_CAUSE",
    "REGRESSION_TEST",
    "SECURITY_AND_PRIVACY_TEST",
    "BUILD",
    "INDEPENDENT_REVIEW",
    "CI_VERDICT",
    "MERGE_TO_NON_FIELD_LINE",
    "FIELD_AUTHORIZATION_GATE",
    "SIGNED_CANDIDATE",
    "SAME_ARTIFACT_FIELD_VERIFY",
    "PROMOTE_OR_FORWARD_REPAIR",
    "LEARN",
    "FREEZE_VERIFIED_BASELINE"
  ],
  "priority_dimensions": [
    "correctness",
    "reliability",
    "security",
    "privacy",
    "field_stability",
    "palestinian_arabic_ar_ps",
    "education_quality",
    "student_eye_correctness",
    "artifact_quality",
    "accessibility",
    "mobile_usability",
    "connectivity_continuity",
    "offline_resilience",
    "model_portability",
    "performance",
    "battery_efficiency",
    "data_efficiency",
    "cost_efficiency",
    "observability",
    "maintainability",
    "test_coverage",
    "deployment_safety",
    "recovery",
    "forward_rollback",
    "documentation",
    "continuation_across_agents_and_conversations"
  ],
  "selection_policy": {
    "wip_limit": 1,
    "material_gain_required": true,
    "prefer_root_cause_over_symptom": true,
    "prefer_small_reversible_change": true,
    "protect_verified_baseline": true,
    "no_change_when_expected_value_non_positive": true,
    "same_failure_requires_strategy_change": true
  },
  "separation_of_duties": {
    "observer": "may detect and request",
    "implementer": "may propose code only in isolated workspace/branch",
    "reviewer": "must independently challenge assumptions and regressions",
    "ci": "authoritative technical gate within tested scope",
    "field_gate": "requires explicit authorization and signed same-artifact evidence",
    "phone": "must not hold repository write credential or signing secret"
  },
  "hard_invariants": {
    "source_mutation_on_device": false,
    "github_secret_on_device": false,
    "signing_secret_on_device": false,
    "isolated_branch_required": true,
    "ci_required": true,
    "root_cause_test_required": true,
    "regression_test_required": true,
    "newer_does_not_inherit_success": true,
    "same_tested_delivered_artifact_required": true,
    "field_install_requires_separate_authorization": true,
    "automatic_permission_expansion": false,
    "automatic_security_boundary_weakening": false,
    "automatic_test_deletion_to_force_pass": false,
    "automatic_downgrade": false,
    "forward_repair_from_verified_baseline": true
  },
  "resume_protocol": {
    "every_agent_must_revalidate_live_state": true,
    "continue_from_last_verified_checkpoint": true,
    "never_restart_from_zero_without_evidence": true,
    "record_next_step_and_blocker": true,
    "record_tested_commit_sha": true,
    "record_field_artifact_sha256_when_available": true,
    "distinguish_source_success_build_success_and_field_success": true
  },
  "provider_independence": {
    "single_model_dependency_forbidden": true,
    "providers_are_replaceable": true,
    "local_models_allowed_when_fit": true,
    "cloud_models_allowed_when_authorized_and_fit": true,
    "routing_criteria": [
      "capability",
      "quality",
      "privacy",
      "availability",
      "latency",
      "cost",
      "task_risk"
    ]
  },
  "completion_rule": "لا يُعلن الاكتمال إلا بدليل يناسب طبقة الادعاء؛ نجاح المصدر لا يعني نجاح البناء، ونجاح البناء لا يعني نجاح الهاتف.",
  "continuity_rule": "تستمر الدورة ما دام هناك مكسب مادي موجب قابل للقياس؛ عند غياب مكسب حقيقي تحفظ الحالة وتتوقف بأمان حتى ظهور دليل أو فرصة جديدة."
